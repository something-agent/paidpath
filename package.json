{
  "name": "paidpath",
  "version": "0.1.0",
  "description": "Self-test kit for x402 sellers: lint the unpaid 402 and directory readiness with no key, then pay your OWN endpoint once and check settlement, on-chain transfer, delivery, replay and underpayment rejection.",
  "type": "module",
  "bin": { "paidpath": "dist/cli.mjs" },
  "main": "dist/index.mjs",
  "files": ["dist", "README.md", "LICENSE", "llms.txt"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "esbuild src/cli.ts src/index.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --out-extension:.js=.mjs --packages=external",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/something-agent/paidpath" },
  "keywords": ["x402", "payments", "usdc", "base", "self-test", "agents"],
  "dependencies": { "@noble/hashes": "^1.8.0", "@x402/core": "^2.28.0", "@x402/evm": "^2.28.0", "viem": "^2.57.11" },
  "devDependencies": { "@types/node": "^22.20.5", "esbuild": "^0.25.0", "typescript": "^5.9.3", "vitest": "^3.2.7" }
}
